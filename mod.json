{
  "geode": "5.9.0",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "nonest.keyviewer",
  "name": "Key Viewer",
  "version": "v0.3.0",
  "developer": "nonest",
  "description": "Dark, glowing key viewer with rising notes, counters, KPS, presets, per-key colors and drag-to-move.",
  "settings": {
    "preset": {
      "type": "string",
      "default": "Custom",
      "one-of": [
        "Custom",
        "Dark",
        "Neon",
        "Rhythm",
        "Light",
        "Minimal"
      ],
      "name": "프리셋",
      "description": "Custom은 아래 설정을 그대로 사용합니다. 다른 프리셋은 색과 효과를 덮어씁니다. (위치와 크기는 유지)"
    },
    "show-timeline": {
      "type": "bool",
      "default": true,
      "name": "노트 타임라인",
      "description": "입력이 막대로 위로 흐르게 표시합니다."
    },
    "show-counter": {
      "type": "bool",
      "default": true,
      "name": "키 카운터",
      "description": "각 키 박스 안에 누른 횟수를 표시합니다."
    },
    "show-kps": {
      "type": "bool",
      "default": true,
      "name": "KPS 표시",
      "description": "초당 입력 수와 최대값을 표시합니다."
    },
    "show-total": {
      "type": "bool",
      "default": true,
      "name": "총 입력 수",
      "description": "총 입력 횟수를 표시합니다."
    },
    "show-glow": {
      "type": "bool",
      "default": true,
      "name": "눌림 글로우",
      "description": "누르는 동안 박스 주변이 빛납니다."
    },
    "note-glow": {
      "type": "bool",
      "default": true,
      "name": "노트 글로우",
      "description": "노트 막대 주변에 부드러운 빛 번짐을 넣습니다."
    },
    "show-p2": {
      "type": "bool",
      "default": false,
      "name": "2P 줄 따로 표시",
      "description": "2인 모드/듀얼에서 1P와 2P 입력을 나눠 표시합니다. 실험적 기능입니다."
    },
    "reset-on-restart": {
      "type": "bool",
      "default": false,
      "name": "재시작 시 카운터 리셋",
      "description": "리트라이할 때마다 카운터와 KPS를 초기화합니다."
    },
    "box-size": {
      "type": "float",
      "default": 44.0,
      "min": 24.0,
      "max": 80.0,
      "control": {
        "slider": true
      },
      "name": "박스 크기"
    },
    "corner-radius": {
      "type": "float",
      "default": 20.0,
      "min": 0.0,
      "max": 50.0,
      "control": {
        "slider": true
      },
      "name": "모서리 둥글기 (%)"
    },
    "box-gap": {
      "type": "float",
      "default": 6.0,
      "min": 0.0,
      "max": 24.0,
      "control": {
        "slider": true
      },
      "name": "박스 간격"
    },
    "tile-opacity": {
      "type": "int",
      "default": 200,
      "min": 0,
      "max": 255,
      "control": {
        "slider": true
      },
      "name": "평소 박스 투명도"
    },
    "tile-color": {
      "type": "rgb",
      "default": [
        18,
        18,
        22
      ],
      "name": "평소 박스 색"
    },
    "pressed-color": {
      "type": "rgb",
      "default": [
        226,
        226,
        232
      ],
      "name": "눌린 박스 색"
    },
    "label-jump": {
      "type": "string",
      "default": "JUMP",
      "name": "점프 키 글자",
      "description": "영문, 숫자, 기호만 가능합니다. 최대 6글자."
    },
    "label-left": {
      "type": "string",
      "default": "<",
      "name": "왼쪽 키 글자",
      "description": "플랫포머 레벨에서 표시됩니다."
    },
    "label-right": {
      "type": "string",
      "default": ">",
      "name": "오른쪽 키 글자",
      "description": "플랫포머 레벨에서 표시됩니다."
    },
    "accent-jump": {
      "type": "rgb",
      "default": [
        255,
        255,
        255
      ],
      "name": "점프 키 노트/글로우 색"
    },
    "accent-left": {
      "type": "rgb",
      "default": [
        255,
        255,
        255
      ],
      "name": "왼쪽 키 노트/글로우 색"
    },
    "accent-right": {
      "type": "rgb",
      "default": [
        255,
        255,
        255
      ],
      "name": "오른쪽 키 노트/글로우 색"
    },
    "note-speed": {
      "type": "float",
      "default": 260.0,
      "min": 100.0,
      "max": 600.0,
      "control": {
        "slider": true
      },
      "name": "노트 속도"
    },
    "note-height": {
      "type": "float",
      "default": 90.0,
      "min": 40.0,
      "max": 220.0,
      "control": {
        "slider": true
      },
      "name": "타임라인 길이"
    },
    "pos-x": {
      "type": "float",
      "default": 85.0,
      "min": 0.0,
      "max": 100.0,
      "control": {
        "slider": true
      },
      "name": "가로 위치 (%)",
      "description": "일시정지 화면에서 박스를 드래그해도 이동합니다."
    },
    "pos-y": {
      "type": "float",
      "default": 10.0,
      "min": 0.0,
      "max": 100.0,
      "control": {
        "slider": true
      },
      "name": "세로 위치 (%)",
      "description": "일시정지 화면에서 박스를 드래그해도 이동합니다."
    }
  }
}
